    {
      "name": "Rejection tests (إثبات الرفض)",
      "item": [
        {
          "name": "Orders - guest -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('error code UNAUTHENTICATED', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));",
                  "pm.test('envelope', () => { const e = pm.response.json().error; pm.expect(e).to.have.all.keys('code','message','details','request_id'); });",
                  "pm.test('no stack trace', () => pm.expect(pm.response.text()).to.not.include('trace'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/orders",
            "description": "بدون توكن."
          },
          "response": []
        },
