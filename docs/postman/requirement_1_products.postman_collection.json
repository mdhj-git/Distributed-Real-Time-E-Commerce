          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('role is customer', () => pm.expect(pm.response.json().data.user.role).to.eql('customer'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"postman.{{$timestamp}}@shop.test\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/auth/register",
            "description": "تسجيل عميل جديد. الدور دائماً customer حتى لو أرسلت role في الجسم."
          },
          "response": []
        },
        {
          "name": "Login (Admin) - يحفظ التوكن",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) {",
                  "    pm.collectionVariables.set('token', body.data.token);",
                  "    console.log('Admin token saved to collection variable token');",
                  "}",
                  "pm.test('admin role', () => pm.expect(body.data.user.role).to.eql('admin'));"
