              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "رابط تسجيل الدخول الجاهز للتوكن:\n{{base_url}}/api/v1/auth/login\n\nهذا الطلب يحفظ data.token تلقائياً في المتغير {{token}}، فتصبح بقية الطلبات المحمية جاهزة دون نسخ يدوي."
          },
          "response": []
        },
