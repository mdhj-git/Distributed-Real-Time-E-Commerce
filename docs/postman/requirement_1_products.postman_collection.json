              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/v1/auth/logout",
            "description": "يشطب الرمز الحالي. بعد تشغيله يصبح {{token}} غير صالح (401) حتى تسجل الدخول من جديد."
          },
          "response": []
        }
      ]
    },
