{
  "info": {
    "_postman_id": "a1b2c3d4-1111-4bbb-8ccc-000000000001",
    "name": "E-Commerce R1 - Products & Security",
    "description": "مجموعة طلبات المتطلب الأول: المستخدمون والمصادقة + المنتجات والتصنيفات + إثبات الأمان.\n\nخطوات البداية:\n1. استورد هذا الملف وملف البيئة local.postman_environment.json.\n2. اختر البيئة \"E-Commerce Local\" أعلى Postman.\n3. شغّل Auth / Login (Admin) أولاً: يحفظ التوكن تلقائياً في المتغير {{token}}.\n4. شغّل Categories / List: يحفظ {{category_id}}.\n5. شغّل Products / List: يحفظ {{product_id}}.\n6. بعدها جرّب بقية الطلبات بالترتيب.\n\nملاحظة: طلب Create Product من نوع multipart، اختر صورة png/jpg/webp من جهازك في الحقل images[].",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Guard against an empty base_url (a blank environment value shadows",
          "// the collection variable and produces an invalid URI like http:///?...).",
          "if (!pm.variables.get('base_url')) {",
          "    pm.variables.set('base_url', 'http://localhost:8080');",
          "}"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "customer_token",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "category_id",
      "value": ""
    },
    {
      "key": "image_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('unified envelope', () => pm.expect(pm.response.json()).to.have.property('data'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/health",
            "description": "فحص صحة الخدمة. يجب أن يعيد 200 مع { data: { status: \"ok\" } }."
          },
          "response": []
        }
      ]
    },
    {
